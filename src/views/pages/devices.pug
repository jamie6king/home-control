extends ../templates/index.pug

block title
    title Devices | Home Control

block content

    include ../components/sidebar

    div#main
        header
            h1 Devices

        main

            if error
                div.banner.alert
                    p= error

            if devices.length == 0
                div.banner.alert
                    p No devices configured.
            else
                ul.device-list
                    for device in devices
                        include ../components/device
