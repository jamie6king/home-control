extends ../templates/index.pug

block head
    script(src="/public/js/devices.js")

block content
    include ../components/sidebar

    div#main
        include ../components/header

        main
            if error
                div.banner.alert
                    p= error

            if devices.length == 0
                div.banner.alert
                    p No devices configured.
            else
                ul.device-list
                    for device in devices
                        include ../components/device
